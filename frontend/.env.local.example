# ==============================================================================
# FraudSight AI - Frontend Environment Configuration (.env.local.example)
# Place in frontend/.env.local for local Next.js development.
# On Vercel, set this under Project Settings -> Environment Variables.
# ==============================================================================

# Backend FastAPI engine URL
# Local development default: http://localhost:8000
# Production: Your Hugging Face Space URL (e.g. https://username-multimodal-fraud-detector.hf.space)
#             or Render URL (e.g. https://multimodal-fraud-detector-1.onrender.com)
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ------------------------------------------------------------------------------
# Sign-in (Auth.js). Production always requires sign-in for /analyze,
# /analytics and /signals. Locally it's off until NEXTAUTH_SECRET is set.
# ------------------------------------------------------------------------------
# Session cookie key: `openssl rand -base64 32`
# NEXTAUTH_SECRET=""
# The site's public address. On Vercel set it to the production domain so the
# OAuth callback matches what you registered.
# NEXTAUTH_URL="http://localhost:3000"

# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client (Web)
#   Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# GitHub: github.com/settings/developers -> New OAuth App
#   Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# Shared with the engine's WEB_AUTH_SECRET; signs 10-minute engine tokens.
# Server-only: never prefix it with NEXT_PUBLIC_.
# WEB_AUTH_SECRET=""
