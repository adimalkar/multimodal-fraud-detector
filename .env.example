# ==============================================================================
# FraudSight AI - Environment Configuration (.env.example)
# Hosting may have free tiers; OpenRouter model requests use paid credits.
# Copy this file to .env and populate your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Model API Gateway (Required for visual screening)
# ------------------------------------------------------------------------------
# OpenRouter API Key (https://openrouter.ai/keys)
# Powers one bounded, low-cost vision-language model request per item.
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
# Optional low-cost model override; only allowlisted model IDs are accepted.
# OPENROUTER_VISION_MODEL="google/gemma-4-26b-a4b-it"

# ------------------------------------------------------------------------------
# 2. Database Persistence (Supabase / Neon PostgreSQL or Local SQLite)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (e.g., Supabase / Neon 100% Free Tier)
# If omitted or left blank, automatically defaults to local SQLite: database/fraud_detection.db
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. Object Storage (Cloudflare R2 - 10GB Free Storage, $0 Egress Fees)
# ------------------------------------------------------------------------------
# Direct client presigned upload bypasses backend memory for large videos/PDFs
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="fraud-evidence"
R2_ENDPOINT_URL="https://your_account_id.r2.cloudflarestorage.com"

# Standard S3 Fallback (Alternative to R2 if using AWS S3 or MinIO)
# S3_ENDPOINT_URL=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME=""

# ------------------------------------------------------------------------------
# 4. Production Guardrails & Free-Tier Memory Limits
# ------------------------------------------------------------------------------
# Maximum file size permitted per uploaded item in Megabytes (Default: 50MB)
MAX_FILE_SIZE_MB=50

# Maximum number of files permitted in a single batch upload (Default: 10 items)
MAX_BATCH_SIZE=10

# Sliding-window rate limit per client IP per minute (Default: 60 requests/min)
RATE_LIMIT_PER_MINUTE=60

# Backend service port (Default: 8000 for local / Hugging Face Spaces, Render injects $PORT)
PORT=8000

# ------------------------------------------------------------------------------
# 5. Opt-in durable private-beta backend (see docs/PHASE1_DURABLE_BACKEND.md)
# ------------------------------------------------------------------------------
# DURABLE_JOBS_ENABLED=1
# DURABLE_DATABASE_URL="postgresql://..."
# DURABLE_ARTIFACT_BACKEND="s3"
# ANALYSIS_TOKENS_JSON='{"tenant-id":"a-random-secret-at-least-32-characters"}'
# DURABLE_EXECUTION_MODE="external"
# CORS_ALLOWED_ORIGINS="https://your-authenticated-frontend.example"
# DURABLE_DAILY_JOBS_PER_TENANT=20
# DURABLE_DAILY_RESERVED_USD=0.50
# DURABLE_RESERVE_PER_JOB_USD=0.01
# DURABLE_RETENTION_DAYS=7
# DURABLE_USAGE_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 6. Opt-in image provenance path (see docs/PHASE2_IMAGE_EVIDENCE.md)
# ------------------------------------------------------------------------------
# Requires durable jobs. Checks embedded C2PA on original bytes with no model calls.
# IMAGE_EVIDENCE_PIPELINE_ENABLED=1
